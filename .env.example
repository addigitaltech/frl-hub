# Database
DATABASE_URL="postgresql://user:password@localhost:5432/frl_hub"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# One-time seed script only (prisma/seed.ts) — creates the first
# SUPER_ADMIN. Not read anywhere else in the app. Remove after first seed.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="FRL Super Admin"

# Scheduled-publish cron (app/api/cron/publish-scheduled)
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# Object storage (S3-compatible) — required before production launch.
# lib/actions/branding.ts currently saves uploads to /public/uploads as a
# dev-only fallback; swap it to use these once storage is provisioned.
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""

# Transactional email (newsletter, notifications) — later phase
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS=""

# WhatsApp Business Platform / Cloud API — later phase
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Web Push — later phase
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
